# API origin only (no /api, no /api/status).
# NEXT_PUBLIC_ is required so browser code (admin login, etc.) can call the API directly.
# Local:
NEXT_PUBLIC_LARAVEL_API_URL=http://127.0.0.1:8000
LARAVEL_API_URL=http://127.0.0.1:8000

# Production (Vercel env + .env.production):
